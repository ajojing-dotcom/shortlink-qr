# Kata sandi untuk masuk ke /admin
ADMIN_PASSWORD=

# Teks acak minimal 32 karakter (contoh: openssl rand -base64 32)
SESSION_SECRET=

# Terisi otomatis saat Upstash Redis disambungkan di Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Mode tamu (bikin link tanpa login) ----
# on / off (bawaan: on)
PUBLIC_MODE=on
# Masa aktif link tamu, hari (bawaan 90)
GUEST_LINK_DAYS=90
# Batas pembuatan link tamu per IP: per-jam,per-hari (bawaan 10,30)
GUEST_RATE_LIMIT=10,30
# Domain yang diblokir, pisahkan koma
BLOCKED_DOMAINS=
# Opsional: cek link ke Google Safe Browsing
GOOGLE_SAFE_BROWSING_KEY=
