# Kata sandi untuk masuk ke /admin
ADMIN_PASSWORD=

# Teks acak minimal 32 karakter (contoh: openssl rand -base64 32)
SESSION_SECRET=

# Mode tamu (buat shortlink tanpa login): on / off
PUBLIC_MODE=on
# Masa aktif link tamu (hari)
GUEST_LINK_DAYS=90
# Batas pembuatan link tamu per IP: per-jam,per-hari
GUEST_RATE_LIMIT=10,30
# Domain yang diblokir, pisahkan dengan koma
BLOCKED_DOMAINS=
# Opsional: cek URL ke Google Safe Browsing
GOOGLE_SAFE_BROWSING_KEY=
# Opsional: Cloudflare Turnstile kalau banyak spam
TURNSTILE_SECRET=

# Terisi otomatis saat Upstash Redis disambungkan di Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
